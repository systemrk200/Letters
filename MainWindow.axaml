<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ScottPlot="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
        x:Class="letters.MainWindow"
        Title="Анализ частоты букв" Width="800" Height="600">

	<Grid RowDefinitions="Auto, Auto, *">
		<!-- 1. Поле для ввода текста -->
		<TextBox Grid.Row="0"
                 x:Name="InputTextBox"
                 Height="120"
                 Margin="10"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 Watermark="Введите или вставьте сюда текст..."/>

		<!-- Кнопка запуска расчета -->
		<Button Grid.Row="1"
                Content="Построить гистограмму"
                Click="OnCalculateClick"
                HorizontalAlignment="Center"
                Padding="15,8"
                Margin="0,0,0,10"/>

		<!-- 3. Область отображения гистограммы -->
		<ScottPlot:AvaPlot Grid.Row="2"
                           x:Name="MyPlot"
                           Margin="10"/>
	</Grid>
</Window>
